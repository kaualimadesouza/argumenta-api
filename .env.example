ARGUMENTA_DATABASE_URL=postgresql+psycopg://argumenta:argumenta@localhost:5432/argumenta

# auth (prod MUST override the secret; 32+ bytes)
ARGUMENTA_JWT_SECRET=dev-only-secret-change-me-before-production
ARGUMENTA_COOKIE_SECURE=false

# Google OAuth (Cloud Console > Credentials > OAuth client, type Web application)
ARGUMENTA_GOOGLE_CLIENT_ID=
ARGUMENTA_GOOGLE_CLIENT_SECRET=

# motor LLM: qual provedor responde (anthropic | openai | google) e a chave dele.
# O nome do modelo pertence ao provedor escolhido, e a calibracao e por
# provedor + modelo + versao de prompt.
ARGUMENTA_LLM_VENDOR=anthropic
ARGUMENTA_ANTHROPIC_API_KEY=
ARGUMENTA_OPENAI_API_KEY=
ARGUMENTA_GOOGLE_API_KEY=
# ARGUMENTA_EVALUATION_MODEL=claude-sonnet-5
# ARGUMENTA_REACTION_MODEL=claude-haiku-4-5
# a reacao pode vir de outro provedor, mais barato, sem mexer na correcao
# ARGUMENTA_REACTION_LLM_VENDOR=google
